# Copy the sender account and its Google App Password into backend/.env.
# Gmail host/port default to smtp.gmail.com:587 and can be omitted.
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM=your-sender@gmail.com

# For another provider, optionally set SMTP_HOST and SMTP_PORT.
# EMAIL_FROM is optional and defaults to SMTP_USER.
